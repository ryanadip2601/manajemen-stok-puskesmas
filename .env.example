APP_NAME="SIMBAR"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domainanda.com

# =====================================================
# DATABASE - HOSTINGER MySQL
# =====================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_simbar_db
DB_USERNAME=u123456789_simbar_user
DB_PASSWORD=your_password_here

# =====================================================
# SESSION & CACHE
# =====================================================
SESSION_DRIVER=file
CACHE_DRIVER=file
LOG_CHANNEL=stack
LOG_LEVEL=error
QUEUE_CONNECTION=sync
SESSION_SECURE_COOKIE=true

# =====================================================
# MAIL - HOSTINGER SMTP
# =====================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@domainanda.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@domainanda.com
MAIL_FROM_NAME="SIMBAR Puskesmas Karang Rejo"
